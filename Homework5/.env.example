# OpenRouter
OPENROUTER_API_KEY=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_CACHE_COLLECTION=semantic_cache

# Redis / Upstash (use the Redis URL, not the REST URL)
# Example: rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
REDIS_URL=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Chunking
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Semantic cache
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600

# Usage DB
USAGE_DB_PATH=/app/data/usage.sqlite3

# Langfuse
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com