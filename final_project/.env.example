# Application
APP_ENV=local

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/whining
POSTGRES_PASSWORD=postgres

# Inference
# local   = MLX on Mac (development)
# remote  = GPU inference service (AWS production)
# openai  = OpenAI API fallback
# mock    = hardcoded response (testing)
INFERENCE_MODE=local
INFERENCE_SERVICE_URL=http://inference:8080
INFERENCE_TIMEOUT=120
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Model (v2 fine-tuned adapter)
MODEL_VERSION=qwen3-8b-lora-v2
BASE_MODEL=mlx-community/Qwen3-8B-4bit
LORA_ADAPTER_PATH=models/adapters/qwen3-8b-lora-v2

# Fallback when model is unavailable
FALLBACK_MESSAGE=Ой лихо, моделі розгубила

# Privacy
STORE_USER_INPUTS=true

# UI
API_URL=http://localhost:8080
