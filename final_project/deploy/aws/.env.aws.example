# Copy to .env.aws and fill in before deployment
# Used by deploy scripts and ECS task definitions

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=123456789012

# ECR image URIs (filled automatically by push-images.sh)
ECR_API=123456789012.dkr.ecr.eu-central-1.amazonaws.com/whiner-api:latest
ECR_UI=123456789012.dkr.ecr.eu-central-1.amazonaws.com/whiner-ui:latest
ECR_INFERENCE=123456789012.dkr.ecr.eu-central-1.amazonaws.com/whiner-inference:latest

# S3 bucket for model artifacts
S3_BUCKET=whiner-models-YOUR_ACCOUNT_ID

# RDS
RDS_ENDPOINT=whiner-db.xxxxx.eu-central-1.rds.amazonaws.com
RDS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME_STRONG_PASSWORD@whiner-db.xxxxx.eu-central-1.rds.amazonaws.com:5432/whining

# GPU inference EC2 (private IP inside VPC)
GPU_INSTANCE_PRIVATE_IP=10.0.1.50
INFERENCE_SERVICE_URL=http://10.0.1.50:8080

# API / model
INFERENCE_MODE=remote
MODEL_VERSION=qwen3-8b-lora-v2
BASE_MODEL=Qwen/Qwen3-8B
LORA_ADAPTER_PATH=/app/models/adapters/qwen3-8b-lora-v2
FALLBACK_MESSAGE="Ой лихо, моделі розгубила"
STORE_USER_INPUTS=true

# Optional OpenAI fallback (set INFERENCE_MODE=openai to skip GPU)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# UI (public ALB URL — set after ALB is created)
API_URL=http://whiner-alb-xxxxx.eu-central-1.elb.amazonaws.com:8080
