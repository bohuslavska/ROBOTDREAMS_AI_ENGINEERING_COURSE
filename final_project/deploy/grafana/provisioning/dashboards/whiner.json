{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "title": "Requests / min",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "expr": "sum(rate(whiner_requests_total[1m])) by (endpoint)",
        "legendFormat": "{{endpoint}}"
      }]
    },
    {
      "title": "Generations / min",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{
        "expr": "sum(rate(whiner_generations_total[1m])) by (model_version)",
        "legendFormat": "{{model_version}}"
      }]
    },
    {
      "title": "Fallback rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "sum(rate(whiner_generations_total{fallback=\"true\"}[5m]))",
        "legendFormat": "fallbacks/min"
      }]
    },
    {
      "title": "Generation latency p95 (s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(whiner_generation_latency_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }]
    },
    {
      "title": "Model available",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
      "targets": [{
        "expr": "whiner_model_available",
        "legendFormat": "available"
      }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["whiner"],
  "time": {"from": "now-1h", "to": "now"},
  "title": "Ukrainian Literary Whiner",
  "uid": "whiner-main",
  "version": 1
}
